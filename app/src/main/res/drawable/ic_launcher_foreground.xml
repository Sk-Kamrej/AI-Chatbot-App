<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

  <!-- Outer Glow Halo -->
  <path
      android:pathData="M54,16 Q54,54 16,54 Q54,54 54,92 Q54,54 92,54 Q54,54 54,16 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="radial"
          android:centerX="54"
          android:centerY="54"
          android:gradientRadius="38"
          android:startX="54"
          android:startY="54"
          android:endX="92"
          android:endY="92">
        <item android:color="#608DA4FF" android:offset="0.0"/>
        <item android:color="#25A0B2FF" android:offset="0.6"/>
        <item android:color="#00000000" android:offset="1.0"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- Middle Star Glow -->
  <path
      android:pathData="M54,20 Q54,54 20,54 Q54,54 54,88 Q54,54 88,54 Q54,54 54,20 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="radial"
          android:centerX="54"
          android:centerY="54"
          android:gradientRadius="34"
          android:startX="54"
          android:startY="54"
          android:endX="88"
          android:endY="88">
        <item android:color="#D8E2FF" android:offset="0.0"/>
        <item android:color="#8FA8FF" android:offset="0.5"/>
        <item android:color="#30617BFF" android:offset="1.0"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- Core White Star -->
  <path
      android:pathData="M54,22 Q54,54 22,54 Q54,54 54,86 Q54,54 86,54 Q54,54 54,22 Z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="radial"
          android:centerX="54"
          android:centerY="54"
          android:gradientRadius="32"
          android:startX="54"
          android:startY="54"
          android:endX="86"
          android:endY="86">
        <item android:color="#FFFFFF" android:offset="0.0"/>
        <item android:color="#EFF3FF" android:offset="0.4"/>
        <item android:color="#B2C6FF" android:offset="0.85"/>
        <item android:color="#8AA4FF" android:offset="1.0"/>
      </gradient>
    </aapt:attr>
  </path>

</vector>